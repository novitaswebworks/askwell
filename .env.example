# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Models (Groq for chat, Ollama for embeddings)
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Optional backup chat provider (any OpenAI-compatible https endpoint), tried only after Groq fails.
# BACKUP_LLM_BASE_URL=https://llm.example.com/v1
# BACKUP_LLM_API_KEY=
# BACKUP_LLM_MODEL=
OLLAMA_BASE_URL=https://your-ollama-host
OLLAMA_API_KEY=your-ollama-bearer-key

# Arcjet Rate Limiting & Bot Protection
ARCJET_KEY=ajkey_...

# Razorpay Subscriptions (rzp_test_ keys = test mode, rzp_live_ = live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_PLAN_ID=plan_your_monthly_pro_plan
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# App & Landing Widget
NEXT_PUBLIC_APP_URL=https://askwell.novitasweb.works
LANDING_WIDGET_KEY=pk_...

# Set to true when the payment gateway is set up and tested; until then the Upgrade button is hidden
BILLING_ENABLED=false

# Search engine ownership tags (the content value of the meta tag each tool gives you)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
