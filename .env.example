# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Models (Groq for chat, Ollama for embeddings)
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Optional backup chat provider (any OpenAI-compatible https endpoint), tried only after Groq fails.
# BACKUP_LLM_BASE_URL=https://llm.example.com/v1
# BACKUP_LLM_API_KEY=
# BACKUP_LLM_MODEL=
OLLAMA_BASE_URL=https://your-ollama-host
OLLAMA_API_KEY=your-ollama-bearer-key

# Arcjet Rate Limiting & Bot Protection
ARCJET_KEY=ajkey_...

# Cashfree Subscriptions
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=your_webhook_secret

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# App & Landing Widget
NEXT_PUBLIC_APP_URL=https://askwell.novitasweb.works
LANDING_WIDGET_KEY=pk_...
